# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the modern publishable key. Keep anon key only for legacy projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-side/admin configuration
# Keep this value only in secure server environments such as Vercel Environment Variables.
# Never expose it in browser/client code.
SUPABASE_SERVICE_ROLE_KEY=

# Fiscal scheduler protection
# Use this value in Vercel Cron through the x-fiscal-sync-secret header when possible.
# Query-string secret remains supported for backwards compatibility, but avoid hardcoding it in vercel.json.
FISCAL_SYNC_SECRET=

# Optional fiscal defaults
SEFAZ_AMBIENTE=homologacao
SEFAZ_UF=35
