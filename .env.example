# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-side/admin configuration
# Keep this value only in secure server environments such as Vercel Environment Variables.
# Do not expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Debug-only API routes.
# Keep disabled in production unless temporarily debugging an incident.
DEBUG_ROUTES_ENABLED=false
