# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
# Modern public key. Legacy JWT-based anon keys are intentionally unsupported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side/admin configuration
# Modern sb_secret_* key. Keep only in secure server environments such as
# Vercel Environment Variables and GitHub Actions secrets. Never expose it in
# browser/client code and do not copy the Production value into Development.
SUPABASE_SECRET_KEY=

# Gestify SaaS rollout guard
# Keep false in Production until persistent staging, isolation tests, restore,
# branch protection and the remaining commercial-readiness gates are complete.
GESTIFY_NEW_SIGNUPS_ENABLED=false
# Set true only after staging + production security verification is complete.
GESTIFY_SECURITY_HARDENING_CONFIRMED=false

# Cron / worker protection
# Vercel Cron authenticates with Authorization Bearer. Prefer dedicated values
# where operational separation is useful; routes can fall back to CRON_SECRET.
CRON_SECRET=
JOB_WORKER_SECRET=
NUTRITION_CRON_SECRET=
ALERTS_CRON_SECRET=

# Fiscal integration is intentionally optional while certificate/configuration
# is not enabled. Do not schedule /api/fiscal/sync until the fiscal gate passes.
FISCAL_SYNC_SECRET=
SEFAZ_AMBIENTE=homologacao
SEFAZ_UF=35

# Optional comma-separated list for browser CORS access to /api routes.
# Same-origin is always allowed.
GESTIFY_ALLOWED_CORS_ORIGINS=

# Optional queue mode for alert e-mails. Keep false until /api/jobs/process is
# scheduled frequently enough for the desired SLA.
GESTIFY_ALERT_EMAIL_QUEUE_ENABLED=false

# Salt for hashing lead IPs before saving public demo requests.
LEAD_IP_HASH_SALT=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional override for alerts. Falls back to RESEND_FROM_EMAIL.
ALERTS_FROM_EMAIL=

# Absolute app URL used in generated emails and server-side links.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
APP_URL=

# Optional operational readiness endpoint credential. CRON_SECRET or
# JOB_WORKER_SECRET can also authenticate the readiness route where supported.
OPERATIONAL_READINESS_SECRET=

# Company creation remains an explicit rollout decision.
GESTIFY_ENABLE_COMPANY_CREATION=false
