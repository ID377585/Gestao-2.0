# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
# Modern public key. Legacy JWT-based anon keys are intentionally unsupported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side/admin configuration
# Modern sb_secret_* key. Keep this value only in secure server environments
# such as Vercel Environment Variables and GitHub Actions secrets.
# Never expose it in browser/client code.
SUPABASE_SECRET_KEY=

# Gestify SaaS rollout guard
# Keep false in Production until the RLS/RPC/storage/dependency hardening checklist is applied and verified.
GESTIFY_NEW_SIGNUPS_ENABLED=false
# Set true only after staging + production security verification is complete.
GESTIFY_SECURITY_HARDENING_CONFIRMED=false

# Fiscal scheduler protection
# Vercel Cron sends Authorization: Bearer $CRON_SECRET when CRON_SECRET is set.
# Query-string secrets are intentionally not accepted. Use Authorization Bearer or protected headers.
FISCAL_SYNC_SECRET=
CRON_SECRET=
ALERTS_CRON_SECRET=
JOB_WORKER_SECRET=

# Optional comma-separated list for browser CORS access to /api routes.
# Same-origin is always allowed.
GESTIFY_ALLOWED_CORS_ORIGINS=

# Optional queue mode for alert e-mails. Keep false until /api/jobs/process is
# configured in Vercel Cron with JOB_WORKER_SECRET or CRON_SECRET.
GESTIFY_ALERT_EMAIL_QUEUE_ENABLED=false

# Salt for hashing lead IPs before saving public demo requests.
LEAD_IP_HASH_SALT=

# Transactional email
# Required for invitations and operational alerts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional override for alerts. Falls back to RESEND_FROM_EMAIL.
ALERTS_FROM_EMAIL=

# Absolute app URL used in generated emails and server-side links.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
APP_URL=

# Optional fiscal defaults
SEFAZ_AMBIENTE=homologacao
SEFAZ_UF=35
