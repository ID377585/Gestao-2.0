{
  "name": "gestao-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "overrides": {
    "brace-expansion": "^2.1.3",
    "js-yaml": "4.3.1",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "next": {
      "sharp": "^0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "excel:smoke": "node scripts/test-excel-export.mjs",
    "supabase:contract": "node scripts/check-supabase-contract.mjs",
    "orders:rls:audit": "node scripts/audit-order-rls.mjs",
    "orders:rls:ci": "node scripts/audit-order-rls.mjs --baseline scripts/order-rls-baseline.json --fail-on-worse",
    "supabase:legacy-tenant:audit": "node scripts/audit-legacy-tenant.mjs",
    "supabase:legacy-tenant:backfill": "node scripts/audit-legacy-tenant.mjs --apply",
    "tenant:writes:audit": "node scripts/audit-tenant-writes.mjs",
    "tenant:writes:ci": "node scripts/audit-tenant-writes.mjs --fail-on-findings --baseline scripts/tenant-writes-baseline.json --quiet",
    "runtime:imports:check": "node scripts/audit-runtime-imports.mjs",
    "dr:fixture": "bash scripts/dr/run-fixture-drill.sh",
    "dr:backup": "bash scripts/dr/create-encrypted-backup.sh",
    "dr:restore": "bash scripts/dr/restore-encrypted-backup.sh",
    "readiness:check": "node scripts/check-production-readiness.mjs",
    "readiness:strict": "node scripts/check-production-readiness.mjs --strict",
    "readiness:deployment": "node scripts/check-deployment-readiness.mjs",
    "ci": "npm run lint && npm run typecheck && npm run audit && npm run excel:smoke && npm run tenant:writes:ci && npm run runtime:imports:check && npm run readiness:check && npm run readiness:deployment && npm run build",
    "postinstall": "node scripts/enforce-production-freeze.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.110.1",
    "@xmldom/xmldom": "^0.9.12",
    "@yudiel/react-qr-scanner": "^2.5.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "heic2any": "^0.0.4",
    "input-otp": "^1.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.561.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "node-forge": "^1.3.1",
    "pdf-parse": "^1.1.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.10.1",
    "soap": "^1.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "xml-crypto": "^6.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/exceljs": "^0.5.3",
    "@types/node": "^20.19.27",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.10",
    "supabase": "^2.72.9",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
