{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run ci",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/fiscal/sync/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/fiscal/sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/jobs/process?limit=20",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/nutricao/notifications/sweep",
      "schedule": "15 * * * *"
    }
  ]
}
